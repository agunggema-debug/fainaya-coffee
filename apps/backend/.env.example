# Application
PORT=3001
NODE_ENV=development

# Database (PostgreSQL - default local docker compose)
DATABASE_URL="postgresql://faianaya:faianaya123@localhost:5432/faianaya_coffee?schema=public"

# Redis (default local docker compose)
REDIS_URL="redis://localhost:6379"

# JWT Secret - GANTI DENGAN STRING ACAK YANG KUAT PADA PRODUCTION!
# Generate contoh: openssl rand -base64 32
JWT_SECRET="ganti-dengan-secret-jwt-rahasia-anda-minimal-32-karakter"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN="http://localhost:3000"

# QRIS (Midtrans/Xendit/Stripe - Sandbox/Production)
QRIS_MERCHANT_ID="your-qris-merchant-id"
QRIS_API_KEY="your-qris-api-key"
QRIS_API_SECRET="your-qris-api-secret"

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false
