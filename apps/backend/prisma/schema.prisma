generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_HQ
  MANAGER_BRANCH
  KASIR
  BARISTA
  WAITER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  QR_ORDER
  KIOSK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  QRIS
  E_WALLET
  CREDIT_CARD
  DEBIT_CARD
  LOYALTY_POINTS
  MIXED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  WASTE
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Branch {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  code          String   @unique
  address       String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  taxRate       Decimal  @default(0) @db.Decimal(5, 4)
  serviceCharge Decimal  @default(0) @db.Decimal(5, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  products      Product[]
  tables        Table[]
  orders        Order[]
  inventories   Inventory[]
  stockMovements StockMovement[]
  shifts        Shift[]
  reservations  Reservation[]
  queues        Queue[]
  auditLogs     AuditLog[]
  categories    Category[]
   customers          Customer[]
   loyaltyTiers       CustomerLoyaltyTier[]
   vouchers           Voucher[]
   deliveryPlatformConfigs DeliveryPlatformConfig[]
   deliveryOrders     DeliveryOrder[]
   suppliers          Supplier[]
   purchaseOrders     PurchaseOrder[]
   accounts           Account[]
   accountingPeriods  AccountingPeriod[]
   journalEntries     JournalEntry[]
   branchPriceOverrides BranchPriceOverride[]
   offlineSyncQueues  OfflineSyncQueue[]

  @@map("branches")
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  branchId      String?     @db.Uuid
  branch        Branch?     @relation(fields: [branchId], references: [id])
  email         String      @unique
  password      String
  name          String
  phone         String?
  role          UserRole    @default(KASIR)
  avatar        String?
  isActive      Boolean     @default(true)
  pin           String?
  commissionRate Decimal      @default(0) @db.Decimal(5, 4)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders        Order[]
  stockMovements StockMovement[]
  shifts        Shift[]
  attendances   Attendance[]
  reservations  Reservation[]
  loyaltyTransactions LoyaltyTransaction[]
   purchaseOrders     PurchaseOrder[]
   journalEntries     JournalEntry[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String?  @db.Uuid
  branch      Branch?  @relation(fields: [branchId], references: [id])
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id            String     @id @default(uuid()) @db.Uuid
  branchId      String     @db.Uuid
  branch        Branch     @relation(fields: [branchId], references: [id])
  categoryId    String?    @db.Uuid
  category      Category?  @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  sku           String?    @unique
  barcode       String?    @unique
  basePrice     Decimal    @db.Decimal(12, 2)
  sellingPrice  Decimal    @db.Decimal(12, 2)
  costPrice     Decimal    @db.Decimal(12, 2) @default(0)
  image         String?
  isAvailable   Boolean    @default(true)
  isPopular     Boolean    @default(false)
  prepTimeMin   Int        @default(5)
  station       String     @default("barista")
  loyaltyPoints Int        @default(0)
  taxIncluded   Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  ingredients   ProductIngredient[]
  orderItems    OrderItem[]
  inventories   Inventory[]
  usedInIngredients ProductIngredient[] @relation("IngredientRelation")
   voucherProducts    VoucherProduct[]
   branchPriceOverrides BranchPriceOverride[]
   purchaseOrderItems PurchaseOrderItem[]

  @@map("products")
}

model ProductIngredient {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  ingredientId String  @db.Uuid
  ingredient  Product  @relation("IngredientRelation", fields: [ingredientId], references: [id])
  quantity    Decimal  @db.Decimal(10, 3)
  unit        String   @default("pcs")
  notes       String?
  createdAt   DateTime @default(now())

  @@map("product_ingredients")
  @@index([productId])
  @@index([ingredientId])
}

model Table {
  id          String     @id @default(uuid()) @db.Uuid
  branchId    String     @db.Uuid
  branch      Branch     @relation(fields: [branchId], references: [id])
  name        String
  tableNumber Int
  status      TableStatus @default(AVAILABLE)
  capacity    Int        @default(2)
  positionX   Decimal    @default(0) @db.Decimal(10, 2)
  positionY   Decimal    @default(0) @db.Decimal(10, 2)
  width       Decimal    @default(100) @db.Decimal(10, 2)
  height      Decimal    @default(100) @db.Decimal(10, 2)
  shape       String     @default("square")
  area        String     @default("indoor")
  isActive    Boolean    @default(true)
  currentOrderId String? @unique @db.Uuid
  currentOrder  Order?   @relation("CurrentTableOrder", fields: [currentOrderId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reservations  Reservation[]
  orders        Order[]    @relation("TableOrders")

  @@map("tables")
  @@index([branchId])
  @@index([status])
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  branchId              String      @db.Uuid
  branch                Branch      @relation(fields: [branchId], references: [id])
  orderNumber           String      @unique
  userId                String      @db.Uuid
  user                  User        @relation(fields: [userId], references: [id])
  tableId               String?     @db.Uuid
  table                 Table?      @relation("TableOrders", fields: [tableId], references: [id])
  currentForTable       Table?      @relation("CurrentTableOrder")
  customerId            String?     @db.Uuid
  customer              Customer?   @relation(fields: [customerId], references: [id])
  customerName          String?
  customerPhone         String?
  customerEmail         String?
  orderType             OrderType   @default(DINE_IN)
  status                OrderStatus @default(PENDING)
  subtotal              Decimal     @db.Decimal(12, 2)
  taxAmount             Decimal     @db.Decimal(12, 2) @default(0)
  serviceChargeAmount   Decimal     @db.Decimal(12, 2) @default(0)
  discountAmount        Decimal     @db.Decimal(12, 2) @default(0)
  totalAmount           Decimal     @db.Decimal(12, 2)
  paidAmount            Decimal     @db.Decimal(12, 2) @default(0)
  changeAmount          Decimal     @db.Decimal(12, 2) @default(0)
  loyaltyPointsEarned   Int         @default(0)
  loyaltyPointsRedeemed Int         @default(0)
  notes                 String?
  kitchenNotes          String?
  preparedAt            DateTime?
  servedAt              DateTime?
  completedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  orderItems     OrderItem[]
  payments       Payment[]
   voucherUsages     VoucherUsage[]
  queue          Queue?
  reservations   Reservation[]
  shifts         Shift[]
  loyaltyTransactions LoyaltyTransaction[]
deliveryOrder     DeliveryOrder?

  @@map("orders")
  @@index([branchId])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
  @@index([tableId])
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id])
  productId      String   @db.Uuid
  product        Product  @relation(fields: [productId], references: [id])
  name           String
  price          Decimal  @db.Decimal(12, 2)
  quantity       Int
  notes          String?
  station        String   @default("barista")
  status         String   @default("pending")
  preparedAt     DateTime?
  servedAt       DateTime?
  printedAt      DateTime?
  createdAt      DateTime @default(now())

  @@map("order_items")
  @@index([orderId])
  @@index([status])
  @@index([station])
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  amount         Decimal  @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionId  String?
  qrisCode       String?
  qrisImage      String?
  qrisNominal    Decimal? @db.Decimal(12, 2)
  qrisExpiredAt  DateTime?
  mdrRate        Decimal? @db.Decimal(5, 4)
  mdrAmount      Decimal? @db.Decimal(12, 2)
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("payments")
  @@index([orderId])
  @@index([status])
  @@index([method])
}

model Inventory {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  currentStock Decimal   @db.Decimal(12, 3) @default(0)
  minStock    Decimal  @db.Decimal(12, 3) @default(0)
  unit        String   @default("pcs")
  lastCounted DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockMovements StockMovement[]

  @@map("inventories")
  @@index([branchId])
  @@index([productId])
}

model StockMovement {
  id              String   @id @default(uuid()) @db.Uuid
  inventoryId     String   @db.Uuid
  inventory       Inventory @relation(fields: [inventoryId], references: [id])
  branchId        String   @db.Uuid
  branch          Branch   @relation(fields: [branchId], references: [id])
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  type            StockMovementType
  quantity        Decimal  @db.Decimal(12, 3)
  quantityBefore  Decimal  @db.Decimal(12, 3)
  quantityAfter   Decimal  @db.Decimal(12, 3)
  reason          String?
  referenceId     String?
  referenceType   String?
  createdAt       DateTime @default(now())

  @@map("stock_movements")
  @@index([branchId])
  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

model Reservation {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  branch         Branch   @relation(fields: [branchId], references: [id])
  tableId        String   @db.Uuid
  table          Table    @relation(fields: [tableId], references: [id])
  orderId         String? @unique @db.Uuid
  order          Order?   @relation(fields: [orderId], references: [id])
  userId         String?  @db.Uuid
  user           User?    @relation(fields: [userId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  guestCount     Int      @default(2)
  reservationDate DateTime
  status         ReservationStatus @default(PENDING)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("reservations")
  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([reservationDate])
}

model Queue {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  orderId     String   @db.Uuid @unique
  order       Order    @relation(fields: [orderId], references: [id])
  position    Int
  status      String   @default("waiting")
  estimatedTime Int?
  calledAt    DateTime?
  servedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("queues")
  @@index([branchId])
  @@index([status])
}

model Shift {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  name        String
  startTime   DateTime
  endTime     DateTime?
  status      ShiftStatus @default(SCHEDULED)
  totalSales  Decimal  @db.Decimal(12, 2) @default(0)
  orderCount  Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendances Attendance[]
  orders      Order[]

  @@map("shifts")
  @@index([branchId])
  @@index([userId])
  @@index([status])
}

model Attendance {
  id           String   @id @default(uuid()) @db.Uuid
  shiftId      String   @db.Uuid
  shift        Shift    @relation(fields: [shiftId], references: [id])
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  clockIn      DateTime?
  clockOut     DateTime?
  clockInPhoto String?
  clockOutPhoto String?
  clockInPin   String?
  clockOutPin  String?
  totalHours   Decimal? @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("attendances")
  @@index([shiftId])
  @@index([userId])
}

model LoyaltyTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  orderId         String? @unique @db.Uuid
  order       Order?   @relation(fields: [orderId], references: [id])
  points      Int
  type        String
  description String?
  createdAt   DateTime @default(now())

  customerId    String?    @db.Uuid
  customer      Customer?  @relation(fields: [customerId], references: [id])
@@map("loyalty_transactions")
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  branchId  String?  @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
}

// ============================================================================
// CRM & LOYALTY MODELS (PRD 3.5)
// ============================================================================
model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  branch         Branch   @relation(fields: [branchId], references: [id])
  name           String
  phone          String   @unique
  email          String?
  avatar         String?
  totalVisits    Int      @default(0)
  totalSpent     Decimal  @db.Decimal(12, 2) @default(0)
  loyaltyPoints  Int      @default(0)
  loyaltyTier    String   @default("bronze")
  isMember       Boolean  @default(false)
  memberSince    DateTime?
  lastVisitAt    DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]
  loyaltyTransactions LoyaltyTransaction[]
  voucherUsages  VoucherUsage[]

  @@map("customers")
  @@index([branchId])
  @@index([phone])
  @@index([loyaltyTier])
}

model CustomerLoyaltyTier {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  minPoints   Int      @default(0)
  pointsMultiplier Decimal @db.Decimal(5, 2) @default(1)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_loyalty_tiers")
  @@index([branchId])
}

// ============================================================================
// VOUCHER & PROMO MODELS (PRD 3.5)
// ============================================================================
model Voucher {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  branch         Branch   @relation(fields: [branchId], references: [id])
  code           String   @unique
  name           String
  description    String?
  type           String   @default("fixed")
  discountValue  Decimal  @db.Decimal(12, 2) @default(0)
  minSpend       Decimal  @db.Decimal(12, 2) @default(0)
  maxDiscount    Decimal? @db.Decimal(12, 2)
  usageLimit     Int?
  usageCount     Int      @default(0)
  perCustomerLimit Int?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean  @default(true)
  appliesToAll   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usages         VoucherUsage[]
  products       VoucherProduct[]

  @@map("vouchers")
  @@index([branchId])
  @@index([code])
  @@index([isActive])
}

model VoucherProduct {
  id        String   @id @default(uuid()) @db.Uuid
  voucherId String   @db.Uuid
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])

  @@map("voucher_products")
  @@index([voucherId])
  @@index([productId])
}

model VoucherUsage {
  id        String   @id @default(uuid()) @db.Uuid
  voucherId String   @db.Uuid
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  customerId String? @db.Uuid
  customer  Customer? @relation(fields: [customerId], references: [id])
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id])
  discountAmount Decimal @db.Decimal(12, 2)
  usedAt    DateTime @default(now())

  @@map("voucher_usages")
  @@index([voucherId])
  @@index([orderId])
}

// ============================================================================
// DELIVERY INTEGRATION MODELS (PRD 3.12)
// ============================================================================
enum DeliveryPlatform {
  GRABFOOD
  GOFOOD
  SHOPEEFOOD
  OTHER
}

enum DeliveryOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model DeliveryPlatformConfig {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  platform    DeliveryPlatform
  apiKey      String?
  apiSecret   String?
  webhookUrl  String?
  webhookSecret String?
  isActive    Boolean  @default(true)
  markupPercent Decimal @db.Decimal(5, 4) @default(0)
  syncEnabled Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveryOrders DeliveryOrder[]

  @@map("delivery_platform_configs")
  @@index([branchId])
  @@unique([branchId, platform])
}

model DeliveryOrder {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  branch         Branch   @relation(fields: [branchId], references: [id])
  platform       DeliveryPlatform
  platformOrderId String   @unique
  platformCustomerName String?
  platformCustomerPhone String?
  platformCustomerAddress String?
  platformFee    Decimal  @db.Decimal(12, 2) @default(0)
  markupAmount   Decimal  @db.Decimal(12, 2) @default(0)
  status         DeliveryOrderStatus @default(PENDING)
  orderId         String? @unique @db.Uuid
  order          Order?   @relation(fields: [orderId], references: [id])
  receivedAt     DateTime?
  confirmedAt    DateTime?
  deliveredAt    DateTime?
  rawPayload     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  platformConfigId String? @db.Uuid
  platformConfig   DeliveryPlatformConfig? @relation(fields: [platformConfigId], references: [id])
@@map("delivery_orders")
  @@index([branchId])
  @@unique([branchId, platform])
  @@index([platformOrderId])
  @@index([status])
}

// ============================================================================
// SUPPLIER & PURCHASE ORDER MODELS (PRD 3.3)
// ============================================================================
model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  taxId       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
  @@index([branchId])
}

model PurchaseOrder {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  supplierId  String   @db.Uuid
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  poNumber    String   @unique
  status      String   @default("draft")
  totalAmount Decimal  @db.Decimal(12, 2) @default(0)
  orderedAt   DateTime @default(now())
  receivedAt  DateTime?
  notes       String?
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PurchaseOrderItem[]

  @@map("purchase_orders")
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId      String   @db.Uuid
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  receivedQuantity Decimal @db.Decimal(12, 3) @default(0)
  notes          String?

  @@map("purchase_order_items")
  @@index([purchaseOrderId])
  @@index([productId])
}

// ============================================================================
// ACCOUNTING MODELS (PRD 3.10)
// ============================================================================
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryType {
  SALES
  COST_OF_SALES
  PURCHASE
  PAYMENT
  EXPENSE
  PAYROLL
  ADJUSTMENT
  OPENING_BALANCE
}

model Account {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  code        String
  name        String
  type        AccountType
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journalEntries JournalEntry[]

  @@map("accounts")
  @@index([branchId])
  @@index([code])
  @@index([type])
}

model AccountingPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journalEntries JournalEntry[]

  @@map("accounting_periods")
  @@index([branchId])
  @@index([isClosed])
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  accountId   String   @db.Uuid
  account     Account  @relation(fields: [accountId], references: [id])
  periodId    String?  @db.Uuid
  period      AccountingPeriod? @relation(fields: [periodId], references: [id])
  entryType   JournalEntryType
  referenceId String?
  referenceType String?
  description String
  debitAmount Decimal  @db.Decimal(12, 2) @default(0)
  creditAmount Decimal @db.Decimal(12, 2) @default(0)
  mdrAmount   Decimal? @db.Decimal(12, 2)
  transactionDate DateTime
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("journal_entries")
  @@index([branchId])
  @@index([accountId])
  @@index([periodId])
  @@index([entryType])
  @@index([transactionDate])
}

// ============================================================================
// BRANCH PRICE OVERRIDE (PRD 3.7 - Harga Berbeda per Cabang)
// ============================================================================
model BranchPriceOverride {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  sellingPrice Decimal @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("branch_price_overrides")
  @@index([branchId])
  @@index([productId])
  @@unique([branchId, productId])
}

// ============================================================================
// OFFLINE SYNC QUEUE (PRD 4.2 - Offline-First)
// ============================================================================
enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

model OfflineSyncQueue {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id])
  entityType  String
  entityId    String?
  action      String
  payload     Json
  status      SyncStatus @default(PENDING)
  retryCount  Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("offline_sync_queue")
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

