{
  "name": "faianaya-coffee",
  "version": "1.1.0",
  "private": true,
  "description": "Faianaya Coffee - Sistem Manajemen Kedai Kopi Terpadu (Open Source)",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=@faianaya/backend",
    "dev:frontend": "npm run dev --workspace=@faianaya/frontend",
    "build": "npm run build --workspaces",
    "db:generate": "npm run prisma:generate --workspace=@faianaya/backend",
    "db:push": "npm run prisma:push --workspace=@faianaya/backend",
    "db:seed": "npm run prisma:seed --workspace=@faianaya/backend",
    "setup:local": "npm run db:push && npm run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@nestjs/cli": "^12.0.12"
  }
}
